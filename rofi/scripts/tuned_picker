#!/usr/bin/env bash

#------------------------------------
# Config and theme
#------------------------------------

file="$HOME/.config/rofi/themes/tunedmenu.rasi"

username=" $(whoami)"

#------------------------------------
# Run rofi
#------------------------------------

rofi_cmd() {
    rofi -dmenu \
        -p "$username" \
        -mesg "Power Profile" \
        -theme "${file}"
}

# Options
powersave=""
balanced="󰖨"
performance="⚡"

run_rofi() {
    echo -e "$powersave\n$balanced\n$performance" | rofi_cmd
}

#------------------------------------
# Run cmds
#------------------------------------

switch_profile() {
    local profile="$1"
    local name="$2"
    local err
    if err=$(sudo tuned-adm profile "$profile" 2>&1); then
        notify-send "Power Profile" "Switched to $name" --urgency=low
    else
        notify-send "Power Profile" "Failed to switch to $name\nError: $err" --urgency=critical
    fi
}

chosen="$(run_rofi)"
case ${chosen} in
    $powersave)
        switch_profile "powersave" "Powersave"
        ;;
    $balanced)
        switch_profile "balanced-battery" "Balanced Battery"
        ;;
    $performance)
        switch_profile "throughput-performance" "Performance"
        ;;
esac

# Force refresh of qtile widget
qtile cmd-obj -o widget tuned -f update_widget
