{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 1,
            "left": 1
        }
    },
    "display": {
        "separator": "\u21DB ",
        "color": {
            "separator": "red"
        },
        "constants": [
            "───────────────────────────────────",
            "│\u001b[35C│\u001b[35D"
        ]
    },
    "modules": [
        {
            "format": "{#1}{#keys}╭{$1}╮\u001b[35D{user-name-colored}{at-symbol-colored}{host-name-colored}",
            "type": "title"
        },
        {
            "key": "{$2}{#33}{icon}  os ",
            "type": "os"
        },
        {
            "key": "{$2}{#32}󰧨  lm ",
            "type": "lm"
        },
        {
            "key": "{$2}{#34}󰇄  wm ",
            "type": "de"
        },
        {
            "key": "{$2}{#35}  tm ",
            "type": "terminal"
        },
        {
            "key": "{$2}{#36}  sh ",
            "type": "shell"
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "key": "{$2}{#39}         ",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "format": "{#1}{#keys}╰{$1}╯",
            "type": "custom"
        }
    ]
}
