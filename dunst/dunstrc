[global]
    font = JetBrainsMono Nerd Font 11
    background = "#343F44"
    foreground = "#D3C6AA"
    frame_color = "#A7C080"
    separator_color = "#4F585E"
    corner_radius = 0
    gap_size = 5
    origin = top-right
    offset = (10, 60)
    notification_limit = 5
    indicate_hidden = true
    sort = urgency_descending
    show_indicators = true
    dmenu = /bin/false
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#343F44"
    foreground = "#859289"
    frame_color = "#4F585E"
    timeout = 5

[urgency_normal]
    background = "#343F44"
    foreground = "#D3C6AA"
    frame_color = "#A7C080"
    timeout = 8

[urgency_critical]
    background = "#343F44"
    foreground = "#E67E80"
    frame_color = "#E67E80"
    timeout = 0
